# ----------------------------------------------------------------------
# Zar Jewels Apache Rewrite & Proxy rules for WHM/cPanel VPS
# ----------------------------------------------------------------------

Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Route API requests to the local Node.js Express backend (port 5001)
  RewriteRule ^api/(.*)$ http://127.0.0.1:5001/api/$1 [P,L]

  # 2. Route uploads requests to the local Node.js Express backend static directory
  RewriteRule ^uploads/(.*)$ http://127.0.0.1:5001/uploads/$1 [P,L]

  # 3. Route all other requests to the local Next.js Admin Dashboard (port 5002)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^(.*)$ http://127.0.0.1:5002/Zar_backend/$1 [P,L]
</IfModule>

# Adjust upload limits if handled by Apache/PHP FPM (optional but helpful)
LimitRequestBody 10485760
