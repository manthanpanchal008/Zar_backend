{
  "name": "jewellery-admin-panel",
  "version": "1.0.0",
  "description": "Backend API for Zar jewels frontend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:backend": "jest --runInBand tests/backend",
    "frontend:dev": "npm --prefix frontend/admin-dashboard run dev",
    "frontend:build": "npm --prefix frontend/admin-dashboard run build",
    "frontend:test": "npm --prefix frontend/admin-dashboard test"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.17.3",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.1.1",
    "mysql2": "^3.6.5",
    "nodemailer": "^8.0.9"
  },
  "devDependencies": {
    "jest": "^30.0.0",
    "nodemon": "^3.0.1",
    "supertest": "^7.1.1"
  }
}
