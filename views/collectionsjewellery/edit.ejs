<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<%- include('../partials/admin-head', { title: 'Edit Collections Jewellery - Zar jewels' }) %>
<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('../partials/admin-sidebar', { user, activePage: 'collectionsjewellery' }) %>

    <div class="main px-lg-4 px-md-4">
      <%- include('../partials/admin-header', { user, pageHeading: 'Edit Collections Jewellery' }) %>

      <div class="body d-flex py-3">
        <div class="container-xxl">
          <% if (error) { %>
            <div class="alert alert-danger shadow-sm" role="alert"><%= error %></div>
          <% } %>

          <div class="card border-0 mb-3">
            <div class="card-header py-3 bg-transparent border-bottom-0 d-flex justify-content-between align-items-center">
              <h6 class="m-0 fw-bold">Update Collections Jewellery Item</h6>
              <a href="/collectionsjewellery" class="btn btn-outline-secondary">Back to Collections Jewellery</a>
            </div>
            <div class="card-body">
              <form action="/collectionsjewellery/edit/<%= item.id %>" method="post" enctype="multipart/form-data" class="row g-3">
                <div class="col-md-6">
                  <label for="collection_type" class="form-label">Collection Type <span class="text-danger">*</span></label>
                  <select id="collection_type" name="collection_type" class="form-select" required>
                    <option value="">-- Select Collection Type --</option>
                    <option value="18k" <%= item.collection_type === '18k' ? 'selected' : '' %>>18 KT Jewellery</option>
                    <option value="22k" <%= item.collection_type === '22k' ? 'selected' : '' %>>22 KT Jewellery</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="category" class="form-label">Category of Collection <span class="text-danger">*</span></label>
                  <input type="text" id="category" name="category" class="form-control" value="<%= item.category || '' %>" required>
                </div>
                <div class="col-md-6">
                  <label for="collection_url" class="form-label">Collection URL</label>
                  <input type="text" id="collection_url" name="collection_url" class="form-control" value="<%= item.collection_url || '' %>" placeholder="bangles-bracelet">
                </div>
                <div class="col-md-6">
                  <label for="image" class="form-label">Image <span class="text-danger">*</span></label>
                  <% if (item.image) { %>
                    <div class="mb-2">
                      <img src="/uploads/jewellery/<%= item.image %>" alt="Current image" style="max-height:80px;border-radius:4px;">
                      <small class="d-block text-muted mt-1">Upload a new image to replace</small>
                    </div>
                  <% } %>
                  <input type="file" id="image" name="image" class="form-control" accept="image/*">
                  <input type="hidden" name="existing_image" value="<%= item.image || '' %>">
                </div>
                <div class="col-12">
                  <button type="submit" class="btn btn-primary">Update Collections Jewellery</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <script src="/js/template.js"></script>
</body>
</html>
