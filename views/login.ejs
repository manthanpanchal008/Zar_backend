<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta http-equiv="X-UA-Compatible" content="IE=Edge">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Login - Zar Jeweller</title>
  <link rel="icon" href="/icon-1.png" type="image/png">
  <link rel="stylesheet" href="/assets/css/ebazar.style.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-bg">
  <div class="container-xxl">
    <div class="row justify-content-center align-items-center auth-page-wrapper">
      <div class="col-lg-5 col-md-7 col-sm-10">
        <div class="card border-0 shadow-sm">
          <div class="card-body p-4 p-lg-5">
            <div class="text-center mb-4">
              <div class="auth-logo mx-auto mb-3">
                <img src="/icon-1.png" alt="Zar Jeweller logo" class="brand-logo-image">
              </div>
              <h4 class="fw-bold mb-1">Zar Jeweller</h4>
            </div>

            <% if (message) { %>
              <div class="alert alert-danger" id="login-toast" role="alert"><%= message %></div>
            <% } %>

            <form action="/login" method="post" class="row g-3">
              <div class="col-12">
                <label for="email" class="form-label">Email</label>
                <input type="email" id="email" name="email" class="form-control form-control-lg" placeholder="Enter your email" required>
              </div>
              <div class="col-12">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control form-control-lg" placeholder="Enter your password" required>
              </div>
              <div class="col-12 d-grid">
                <button type="submit" class="btn btn-primary btn-lg">Login</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <% if (message) { %>
    <script>
      setTimeout(function () {
        var toast = document.getElementById('login-toast');
        if (!toast) return;
        toast.style.transition = 'opacity 0.5s ease';
        toast.style.opacity = '0';
        setTimeout(function () {
          toast.remove();
        }, 500);
      }, 3000);
    </script>
  <% } %>
</body>
</html>
