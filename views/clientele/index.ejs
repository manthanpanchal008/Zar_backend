<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<%- include('../partials/admin-head', { title: 'Clientele - Zar jewels' }) %>
<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('../partials/admin-sidebar', { user, activePage: 'clientele' }) %>

    <div class="main px-lg-4 px-md-4">
      <%- include('../partials/admin-header', { user, pageHeading: 'Clientele' }) %>

      <div class="body d-flex py-3">
        <div class="container-xxl">
          <% if (message) { %>
            <div class="alert alert-success shadow-sm" role="alert"><%= message %></div>
          <% } %>
          <% if (error) { %>
            <div class="alert alert-danger shadow-sm" role="alert"><%= error %></div>
          <% } %>

          <div class="card">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom-0">
              <h6 class="m-0 fw-bold">Clientele</h6>
              <% if (user.role === 'admin') { %>
                <a href="/clientele/add" class="btn btn-primary">Add Clientele</a>
              <% } %>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table id="myDataTable" class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Image</th>
                      <th>Title</th>
                      <% if (user.role === 'admin') { %><th>Actions</th><% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% clientele.forEach((item) => { %>
                      <tr>
                        <td>
                          <% if (item.image_url) { %>
                            <img src="<%= item.image_url %>" alt="Clientele" style="width:54px;height:54px;object-fit:cover;border-radius:8px;">
                          <% } else { %>
                            <span class="text-muted">-</span>
                          <% } %>
                        </td>
                        <td><%= item.clientele_title %></td>
                        <% if (user.role === 'admin') { %>
                          <td>
                            <a href="/clientele/edit/<%= item.id %>" class="btn btn-sm btn-warning">Edit</a>
                            <form action="/clientele/delete/<%= item.id %>" method="post" class="d-inline" onsubmit="return confirm('Delete clientele \"<%= item.clientele_title %>\"?')">
                              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                          </td>
                        <% } %>
                      </tr>
                    <% }) %>
                    <% if (clientele.length === 0) { %>
                      <tr>
                        <td colspan="<%= user.role === 'admin' ? 5 : 4 %>" class="text-center text-muted py-4">No clientele found.</td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <script src="/assets/bundles/dataTables.bundle.js"></script>
  <script src="/js/template.js"></script>
  <script>
    if (window.$ && $('#myDataTable').length) {
      $('#myDataTable').addClass('nowrap').dataTable({ responsive: true });
    }
  </script>
</body>
</html>
