<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<%- include('../partials/admin-head', { title: 'Edit Clientele - Zar Jweller' }) %>
<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('../partials/admin-sidebar', { user, activePage: 'clientele' }) %>

    <div class="main px-lg-4 px-md-4">
      <%- include('../partials/admin-header', { user, pageHeading: 'Edit Clientele' }) %>

      <div class="body d-flex py-3">
        <div class="container-xxl">
          <% if (error) { %>
            <div class="alert alert-danger shadow-sm" role="alert"><%= error %></div>
          <% } %>

          <div class="card border-0 mb-3">
            <div class="card-header py-3 bg-transparent border-bottom-0 d-flex justify-content-between align-items-center">
              <h6 class="m-0 fw-bold">Edit Clientele</h6>
              <a href="/clientele" class="btn btn-outline-secondary">Back to Clientele</a>
            </div>
            <div class="card-body">
              <form action="/clientele/edit/<%= clienteleItem.id %>" method="post" enctype="multipart/form-data" class="row g-3">

                <div class="col-md-4">
                  <label for="clientele_title" class="form-label">Clientele Title <span class="text-danger">*</span></label>
                  <input type="text" id="clientele_title" name="clientele_title" class="form-control" value="<%= clienteleItem.clientele_title || '' %>" required>
                </div>

                <div class="col-md-4">
                  <label for="country" class="form-label">Country <span class="text-danger">*</span></label>
                  <select id="country" name="country" class="form-control" required>
                    <option value="India" <%= (clienteleItem.country === 'India' || !clienteleItem.country) ? 'selected' : '' %>>India</option>
                    <option value="UAE" <%= clienteleItem.country === 'UAE' ? 'selected' : '' %>>UAE</option>
                  </select>
                </div>

                <div class="col-md-4">
                  <label for="clientele_image" class="form-label">Clientele Image</label>
                  <input type="file" id="clientele_image" name="clientele_image" class="form-control" accept="image/*">
                </div>

                <% if (clienteleItem.image_url) { %>
                  <div class="col-12">
                    <img src="<%= clienteleItem.image_url %>" alt="Current clientele" style="width:100px;height:100px;object-fit:cover;border-radius:8px;">
                  </div>
                <% } %>

                <div class="col-12">
                  <button type="submit" class="btn btn-primary">Update Clientele</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <script src="/js/template.js"></script>
</body>
</html>
