<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<%- include('../partials/admin-head', { title: 'Products - Zar jewels' }) %>
<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('../partials/admin-sidebar', { user, activePage: 'products' }) %>

    <div class="main px-lg-4 px-md-4">
      <%- include('../partials/admin-header', { user, pageHeading: 'Products' }) %>

      <div class="body d-flex py-3">
        <div class="container-xxl">
          <% if (message) { %>
            <div class="alert alert-success shadow-sm" role="alert"><%= message %></div>
          <% } %>
          <% if (error) { %>
            <div class="alert alert-danger shadow-sm" role="alert"><%= error %></div>
          <% } %>

          <div class="card">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom-0">
              <h6 class="m-0 fw-bold">Product Catalog</h6>
              <% if (user.role === 'admin') { %>
                <a href="/products/add" class="btn btn-primary">Add Product</a>
              <% } %>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table id="myDataTable" class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>Image</th>
                      <th>Product Title</th>
                      <th>Collection Name</th>
                      <th>Category</th>
                      <th>Subcategory</th>
                      
                      <% if (user.role === 'admin') { %><th>Actions</th><% } %>
                    </tr>
                  </thead>
                  <tbody>
                    <% items.forEach((item) => { %>
                      <tr>
                        <td>
                          <% if (item.product_images && item.product_images.length > 0) { %>
                            <img src="/uploads/products/<%= item.product_images[0] %>" alt="Product" style="width:54px;height:54px;object-fit:cover;border-radius:8px;">
                          <% } else { %>
                            <span class="text-muted">-</span>
                          <% } %>
                        </td>
                        <td>
                          <div class="fw-semibold"><%= item.title || '-' %></div>
                        </td>
                        <td><%= item.collection_name || '-' %></td>
                        <td><%= item.category_name || '-' %></td>
                        <td><%= item.subcategory_name || '-' %></td>

                        <% if (user.role === 'admin') { %>
                          <td>
                            <a href="/products/edit/<%= item.id %>" class="btn btn-sm btn-warning">Edit</a>
                            <form action="/products/delete/<%= item.id %>" method="post" class="d-inline" onsubmit="return confirm('Delete this product?')">
                              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                          </td>
                        <% } %>
                      </tr>
                    <% }) %>
                    <% if (items.length === 0) { %>
                      <tr>
                        <td colspan="<%= user.role === 'admin' ? 7 : 6 %>" class="text-center text-muted py-4">No products found.</td>
                      </tr>
                    <% } %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <script src="/assets/bundles/dataTables.bundle.js"></script>
  <script src="/js/template.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      if (typeof $.fn.DataTable !== 'undefined') {
        $('#myDataTable').DataTable({ responsive: true });
      }
    });
  </script>
</body>
</html>
