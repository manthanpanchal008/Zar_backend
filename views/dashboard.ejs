<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<%- include('partials/admin-head', { title: 'Dashboard - Zar Jweller' }) %>
<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('partials/admin-sidebar', { user, activePage: 'dashboard' }) %>

    <div class="main px-lg-4 px-md-4">
      <%- include('partials/admin-header', { user, pageHeading: 'Dashboard' }) %>

      <div class="body d-flex py-3">
        <div class="container-xxl">
          <% if (message) { %>
            <div class="alert alert-info shadow-sm" role="alert"><%= message %></div>
          <% } %>

          <div class="row g-3 mb-4 row-deck">
            <div class="col-xl-4 col-lg-6 col-md-6">
              <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between">
                  <div>
                    <span class="text-muted">Total Events</span>
                    <div><span class="fs-5 fw-bold"><%= Number(eventCount || 0) %></span></div>
                  </div>
                  <i class="icofont-calendar fs-3 color-lightblue"></i>
                </div>
              </div>
            </div>
            <div class="col-xl-4 col-lg-6 col-md-6">
              <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between">
                  <div>
                    <span class="text-muted">Total Contacts</span>
                    <div><span class="fs-5 fw-bold"><%= summary ? summary.totalContacts : 0 %></span></div>
                  </div>
                  <i class="icofont-address-book fs-3 color-light-success"></i>
                </div>
              </div>
            </div>
            <div class="col-xl-4 col-lg-6 col-md-6">
              <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between">
                  <div>
                    <span class="text-muted">Total Users</span>
                    <div><span class="fs-5 fw-bold"><%= summary ? summary.totalUsers : 0 %></span></div>
                  </div>
                  <i class="icofont-users-social fs-3 color-warning"></i>
                </div>
              </div>
            </div>
          </div>

          <div class="row g-3 mb-4 row-deck">
            <div class="col-xl-3 col-lg-6 col-md-6">
              <div class="card"><div class="card-body"><span class="text-muted">Collections Jewellery Items</span><h5 class="mb-0 mt-2"><%= summary ? summary.totalJewels : 0 %></h5></div></div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6">
              <div class="card"><div class="card-body"><span class="text-muted">Admin Accounts</span><h5 class="mb-0 mt-2"><%= summary ? summary.totalAdmins : 0 %></h5></div></div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6">
              <div class="card"><div class="card-body"><span class="text-muted">Staff Accounts</span><h5 class="mb-0 mt-2"><%= summary ? summary.totalStaff : 0 %></h5></div></div>
            </div>
            <div class="col-xl-3 col-lg-6 col-md-6">
              <div class="card"><div class="card-body"><span class="text-muted">Latest Collection Category</span><h5 class="mb-0 mt-2 text-truncate"><%= summary && summary.latestJewel ? summary.latestJewel.category : 'No items yet' %></h5></div></div>
            </div>
          </div>

          <div class="card" id="inventory-panel">
            <div class="card-header py-3 d-flex justify-content-between align-items-center bg-transparent border-bottom-0">
              <h6 class="m-0 fw-bold">Collections Jewellery Inventory</h6>
              <% if (user.role === 'admin') { %>
                <a href="/collectionsjewellery/add" class="btn btn-primary">Add New Collection</a>
              <% } %>
            </div>
            <div class="card-body">
              <div class="table-responsive">
                <table id="myDataTable" class="table table-hover align-middle mb-0">
                  <thead>
                    <tr>
                      <th>ID</th>
                      <th>Collection Type</th>
                      <th>Category</th>
                      <th>Image</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    <% jewels.forEach((jewel) => { %>
                      <tr>
                        <td><%= jewel.id %></td>
                        <td><%= (jewel.collection_type || '').toUpperCase() %></td>
                        <td class="text-muted"><%= jewel.category || '-' %></td>
                        <td>
                          <% if (jewel.image) { %>
                            <img src="/uploads/jewellery/<%= jewel.image %>" alt="Collection image" style="width:40px;height:40px;object-fit:cover;border-radius:6px;">
                          <% } else { %>
                            <span class="text-muted">-</span>
                          <% } %>
                        </td>
                        <td>
                          <% if (user.role === 'admin') { %>
                            <a href="/collectionsjewellery/edit/<%= jewel.id %>" class="btn btn-sm btn-warning">Edit</a>
                            <form action="/collectionsjewellery/delete/<%= jewel.id %>" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this collection item?')">
                              <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                            </form>
                          <% } else { %>
                            <span class="badge bg-light text-dark">View only</span>
                          <% } %>
                        </td>
                      </tr>
                    <% }) %>
                  </tbody>
                </table>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <script src="/assets/bundles/dataTables.bundle.js"></script>
  <script src="/js/template.js"></script>
  <script>
    if (window.$ && $('#myDataTable').length) {
      $('#myDataTable').addClass('nowrap').dataTable({ responsive: true });
    }
  </script>
</body>
</html>