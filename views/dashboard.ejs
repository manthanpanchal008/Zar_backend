<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<%- include('partials/admin-head', { title: 'Dashboard - Zar jewels' }) %>
<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('partials/admin-sidebar', { user, activePage: 'dashboard' }) %>

    <div class="main px-lg-4 px-md-4">
      <%- include('partials/admin-header', { user, pageHeading: 'Dashboard' }) %>

      <div class="body d-flex py-3">
        <div class="container-xxl">
          <% if (message) { %>
            <div class="alert alert-info shadow-sm" role="alert"><%= message %></div>
          <% } %>

          <div class="row g-3 mb-4 row-deck">
            <div class="col-xl-4 col-lg-6 col-md-6">
              <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between">
                  <div>
                    <span class="text-muted">Total Products</span>
                    <div><span class="fs-5 fw-bold"><%= summary ? summary.totalProducts : 0 %></span></div>
                  </div>
                  <i class="icofont-diamond fs-3 color-warning"></i>
                </div>
              </div>
            </div>
            <div class="col-xl-4 col-lg-6 col-md-6">
              <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between">
                  <div>
                    <span class="text-muted">Total Events</span>
                    <div><span class="fs-5 fw-bold"><%= Number(eventCount || 0) %></span></div>
                  </div>
                  <i class="icofont-calendar fs-3 color-lightblue"></i>
                </div>
              </div>
            </div>
            <div class="col-xl-4 col-lg-6 col-md-6">
              <div class="card">
                <div class="card-body d-flex flex-wrap align-items-center justify-content-between">
                  <div>
                    <span class="text-muted">Total Contacts</span>
                    <div><span class="fs-5 fw-bold"><%= summary ? summary.totalContacts : 0 %></span></div>
                  </div>
                  <i class="icofont-address-book fs-3 color-light-success"></i>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <script src="/js/template.js"></script>
  <script>
    // Table without pagination controls
    if (window.$ && $('#myDataTable').length) {
      $('#myDataTable').addClass('nowrap').dataTable({
        responsive: true,
        paging: false,
        info: false,
        searching: true,
        ordering: true
      });
    }
  </script>
</body>
</html>