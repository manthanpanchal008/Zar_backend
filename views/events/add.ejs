<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<%- include('../partials/admin-head', { title: 'Add Event - Zar jewels' }) %>
<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('../partials/admin-sidebar', { user, activePage: 'events' }) %>

    <div class="main px-lg-4 px-md-4">
      <%- include('../partials/admin-header', { user, pageHeading: 'Add Event' }) %>

      <div class="body d-flex py-3">
        <div class="container-xxl">
          <% if (error) { %>
            <div class="alert alert-danger shadow-sm" role="alert"><%= error %></div>
          <% } %>

          <div class="card border-0 mb-3">
            <div class="card-header py-3 bg-transparent border-bottom-0 d-flex justify-content-between align-items-center">
              <h6 class="m-0 fw-bold">Create Exhibition / Show</h6>
              <a href="/events" class="btn btn-outline-secondary">Back to Events</a>
            </div>
            <div class="card-body">
              <form action="/events/add" method="post" enctype="multipart/form-data" class="row g-3">

                <div class="col-md-8">
                  <label for="title" class="form-label">Event Title <span class="text-danger">*</span></label>
                  <input type="text" id="title" name="title" class="form-control"
                    value="<%= formData.title || '' %>" placeholder="Enter The Event Name" required>
                </div>

                <div class="col-md-4">
                  <label for="status" class="form-label">Status <span class="text-danger">*</span></label>
                  <select id="status" name="status" class="form-select" required>
                    <% statuses.forEach((s) => { %>
                      <option value="<%= s %>" <%= (formData.status || 'upcoming') === s ? 'selected' : '' %>>
                        <%= s.charAt(0).toUpperCase() + s.slice(1) %>
                      </option>
                    <% }) %>
                  </select>
                </div>

                <div class="col-md-6">
                  <label for="location" class="form-label">Location</label>
                  <input type="text" id="location" name="location" class="form-control"
                    value="<%= formData.location || '' %>" placeholder="Enter the event location">
                </div>

                <div class="col-md-3">
                  <label for="start_date" class="form-label">Start Date</label>
                  <input type="date" id="start_date" name="start_date" class="form-control"
                    value="<%= formData.start_date || '' %>">
                </div>

                <div class="col-md-3">
                  <label for="end_date" class="form-label">End Date</label>
                  <input type="date" id="end_date" name="end_date" class="form-control"
                    value="<%= formData.end_date || '' %>">
                </div>

                <div class="col-12">
                  <label for="description" class="form-label">Description</label>
                  <textarea id="description" name="description" class="form-control summernote" rows="6"
                    placeholder="Short description of the event…"><%= formData.description || '' %></textarea>
                </div>

                <div class="col-md-6">
                  <label for="event_url" class="form-label">Event Link Slug / URL</label>
                  <input type="text" id="event_url" name="event_url" class="form-control"
                    value="<%= formData.event_url || '' %>" placeholder="Enter the Slug">
                  <small class="text-muted">Enter the Slug</small>
                </div>

                <div class="col-md-6">
                  <label for="images" class="form-label">Event Images</label>
                  <input type="file" id="images" name="images" class="form-control" accept="image/*" multiple>
                  <small class="text-muted">You can upload up to 10 images.</small>
                </div>

                <% const   = (typeof uploadedImagePaths !== 'undefined' && Array.isArray(uploadedImagePaths)) ? uploadedImagePaths : []; %>
                <% if (safeUploadedImagePaths.length > 0) { %>
                  <div class="col-12">
                    <div class="d-flex flex-wrap gap-2">
                      <% safeUploadedImagePaths.forEach((img) => { %>
                        <img src="/uploads/events/<%= img %>" alt="Uploaded image" style="width:90px;height:90px;object-fit:cover;border-radius:8px;">
                      <% }) %>
                    </div>
                  </div>
                <% } %>

                <div class="col-12">
                  <button type="submit" class="btn btn-primary">Create Event</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.css">
  <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.20/dist/summernote-lite.min.js"></script>
  <script src="/js/template.js"></script>
  <script>
    if (window.$ && $.fn && $.fn.summernote && $('#description').length) {
      $('#description').summernote({
        height: 220,
        placeholder: 'Write event details here...',
        toolbar: [
          ['style', ['bold', 'italic', 'underline', 'clear']],
          ['font', ['strikethrough']],
          ['para', ['ul', 'ol', 'paragraph']],
          ['insert', ['link']],
          ['view', ['codeview']]
        ]
      });
    }
  </script>
</body>
</html>
