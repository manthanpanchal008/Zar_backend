<!DOCTYPE html>
<html class="no-js" lang="en" dir="ltr">
<%- include('../partials/admin-head', { title: 'Add Subcategory - Zar Jweller' }) %>
<body>
  <div id="ebazar-layout" class="theme-blue">
    <%- include('../partials/admin-sidebar', { user, activePage: 'subcategories' }) %>

    <div class="main px-lg-4 px-md-4">
      <%- include('../partials/admin-header', { user, pageHeading: 'Add Subcategory' }) %>

      <div class="body d-flex py-3">
        <div class="container-xxl">
          <% if (error) { %>
            <div class="alert alert-danger shadow-sm" role="alert"><%= error %></div>
          <% } %>

          <div class="card border-0 mb-3">
            <div class="card-header py-3 bg-transparent border-bottom-0 d-flex justify-content-between align-items-center">
              <h6 class="m-0 fw-bold"></h6>
              <a href="/subcategories" class="btn btn-outline-secondary">Back to Subcategories</a>
            </div>
            <div class="card-body">
              <form action="/subcategories/add" method="post" enctype="multipart/form-data" class="row g-3">
                <div class="col-md-6">
                  <label for="collection_type" class="form-label">Collection Type <span class="text-danger">*</span></label>
                  <select id="collection_type" name="collection_type" class="form-select" required>
                    <option value="">-- Select Collection Type --</option>
                    <option value="18k" <%= formData && formData.collection_type === '18k' ? 'selected' : '' %>>18 KT Jewellery</option>
                    <option value="22k" <%= formData && formData.collection_type === '22k' ? 'selected' : '' %>>22 KT Jewellery</option>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="category_id" class="form-label">Parent Category <span class="text-danger">*</span></label>
                  <select id="category_id" name="category_id" class="form-select" required>
                    <option value="">-- Select Parent Category --</option>
                    <% categories.forEach((category) => { %>
                      <option value="<%= category.id %>" data-collection-type="<%= category.collection_type %>" <%= Number(formData && formData.category_id) === Number(category.id) ? 'selected' : '' %>>
                        <%= category.category %>
                      </option>
                    <% }) %>
                  </select>
                </div>
                <div class="col-md-6">
                  <label for="category" class="form-label">Subcategory Name <span class="text-danger">*</span></label>
                  <input type="text" id="category" name="category" class="form-control" value="<%= formData && formData.category ? formData.category : '' %>" required>
                </div>
                <div class="col-md-6">
                  <label for="subcategory_url" class="form-label">Subcategory URL</label>
                  <input type="text" id="subcategory_url" name="subcategory_url" class="form-control" value="<%= formData && formData.subcategory_url ? formData.subcategory_url : '' %>" placeholder="plain-handmade">
                </div>
                <div class="col-md-6">
                  <label for="image" class="form-label">Image <span class="text-danger">*</span></label>
                  <input type="file" id="image" name="image" class="form-control" accept="image/*" required>
                </div>
                <div class="col-12">
                  <button type="submit" class="btn btn-primary">Add Subcategory</button>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/assets/bundles/libscripts.bundle.js"></script>
  <script src="/js/template.js"></script>
  <script>
    document.addEventListener('DOMContentLoaded', function () {
      const collectionTypeSelect = document.getElementById('collection_type');
      const categorySelect = document.getElementById('category_id');

      async function loadCategories() {
        const collectionType = String(collectionTypeSelect.value || '').trim();
        const currentSelectedCategoryId = String(categorySelect.value || '');
        categorySelect.disabled = true;

        try {
          const response = await fetch(`/api/product-categories?collection_type=${encodeURIComponent(collectionType)}`);
          const payload = await response.json();
          const categories = Array.isArray(payload.categories) ? payload.categories : [];

          categorySelect.innerHTML = '<option value="">-- Select Parent Category --</option>';
          categories.forEach((category) => {
            const option = document.createElement('option');
            option.value = String(category.id);
            option.textContent = category.category;
            if (String(category.id) === currentSelectedCategoryId) {
              option.selected = true;
            }
            categorySelect.appendChild(option);
          });
        } catch (_error) {
          categorySelect.innerHTML = '<option value="">-- Select Parent Category --</option>';
        } finally {
          categorySelect.disabled = false;
        }
      }

      collectionTypeSelect.addEventListener('change', loadCategories);

      if (collectionTypeSelect.value) {
        loadCategories();
      }
    });
  </script>
</body>
</html>
